#!/bin/sh
# cwagent-fetch — download the CloudWatch agent .deb and verify its GPG
# signature against AWS's pinned key fingerprint before anything installs it.
#
#   cwagent-fetch <region> <arch: arm64|amd64> <output .deb path>
#
# Exits non-zero (and removes the output) on any download or signature failure.
# Steps follow AWS's "Verifying the signature of the CloudWatch agent package".
set -eu

REGION=$1
ARCH=$2
OUT=$3
# From the AWS doc; a key that doesn't match this is rejected.
FINGERPRINT=937616F3450B7D806CBD9725D58167303B789C72
BASE="https://amazoncloudwatch-agent-${REGION}.s3.${REGION}.amazonaws.com"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
fetch() { curl -fsSL --proto '=https' --tlsv1.2 -o "$2" "$1"; }

fetch "$BASE/assets/amazon-cloudwatch-agent.gpg" "$WORK/key.gpg"
fetch "$BASE/debian/$ARCH/latest/amazon-cloudwatch-agent.deb" "$WORK/agent.deb"
fetch "$BASE/debian/$ARCH/latest/amazon-cloudwatch-agent.deb.sig" "$WORK/agent.deb.sig"

export GNUPGHOME="$WORK/gnupg"
mkdir -m 700 "$GNUPGHOME"
GOT=$(gpg --batch --with-colons --show-keys "$WORK/key.gpg" | awk -F: '$1=="fpr"{print $10; exit}')
if [ "$GOT" != "$FINGERPRINT" ]; then
    echo "cwagent-fetch: key fingerprint $GOT != pinned $FINGERPRINT" >&2
    exit 1
fi
gpg --batch --dearmor -o "$WORK/key.kbx" "$WORK/key.gpg" 2>/dev/null || cp "$WORK/key.gpg" "$WORK/key.kbx"
if ! gpgv --keyring "$WORK/key.kbx" "$WORK/agent.deb.sig" "$WORK/agent.deb" 2>"$WORK/gpgv.log"; then
    cat "$WORK/gpgv.log" >&2
    echo "cwagent-fetch: BAD signature on amazon-cloudwatch-agent.deb" >&2
    exit 1
fi
install -m 0644 "$WORK/agent.deb" "$OUT"
echo "cwagent-fetch: verified $OUT"
